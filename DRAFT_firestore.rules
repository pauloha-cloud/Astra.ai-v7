rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerified() && request.auth.token.email == 'pauloazevedo2@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt'])
        && data.keys().size() <= 6
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && data.createdAt == request.time;
    }

    function isValidAnalysis(data) {
      return data.keys().hasAll(['userId', 'videoId', 'title', 'createdAt'])
        && data.keys().size() <= 10
        && data.userId == request.auth.uid
        && data.videoId is string && data.videoId.size() <= 50
        && data.title is string && data.title.size() <= 200
        && (data.get('summary', '') is string && data.get('summary', '').size() <= 50000)
        && data.createdAt == request.time;
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isVerified() && isValidId(userId) && userId == request.auth.uid && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL'])
      );

      match /analyses/{analysisId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isVerified() && isValidId(userId) && isValidId(analysisId) && isValidAnalysis(incoming());
        allow update: if isOwner(userId) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['summary', 'quiz', 'mindMap'])
          && incoming().userId == existing().userId
          && incoming().videoId == existing().videoId
        );
        allow delete: if isOwner(userId);
      }
    }
  }
}
