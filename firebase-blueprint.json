{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and subscription data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "plan": { "enum": ["free", "basic", "premium"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "Analysis": {
      "title": "Analysis",
      "description": "YouTube video analysis results including summaries, quiz, and mind map",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "video": {
          "type": "object",
          "properties": {
            "videoId": { "type": "string" },
            "url": { "type": "string" },
            "title": { "type": "string" },
            "channel": { "type": "string" },
            "thumbnail": { "type": "string" }
          }
        },
        "mode": { "enum": ["transcript", "metadata_fallback"] },
        "message": { "type": "string" },
        "summary": { "type": "string", "description": "Markdown summary" },
        "key_points": { "type": "array", "items": { "type": "string" } },
        "quiz": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "question": { "type": "string" },
              "options": { "type": "array", "items": { "type": "string" } },
              "answer": { "type": "string" },
              "explanation": { "type": "string" }
            }
          }
        },
        "mind_map": {
          "type": "object",
          "properties": {
            "topic": { "type": "string" },
            "children": { "type": "array", "items": { "type": "object" } }
          }
        },
        "tutor_questions": { "type": "array", "items": { "type": "string" } },
        "limitations": { "type": "array", "items": { "type": "string" } },
        "transcript": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "video", "mode", "summary", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles"
    },
    "/users/{userId}/analyses/{analysisId}": {
      "schema": "Analysis",
      "description": "Analyses performed by the user"
    }
  }
}
