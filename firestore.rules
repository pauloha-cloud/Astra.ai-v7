rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity Test Path
    match /test/connection {
      allow read: if true;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    // Admin check - only include if explicitly needed. Using user email as requested.
    function isAdmin() {
      return isVerified() && request.auth.token.email == 'pauloazevedo2@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.email is string && data.email.size() <= 256
        && (data.get('displayName', null) == null || (data.get('displayName', '') is string && data.get('displayName', '').size() <= 256))
        && (data.get('photoURL', null) == null || (data.get('photoURL', '') is string && data.get('photoURL', '').size() <= 4096))
        && (data.get('plan', 'free') in ['free', 'start', 'starter', 'explorer', 'pro', 'basic', 'premium']);
    }

    function isValidAnalysis(data) {
      return data.userId == request.auth.uid
        && data.video is map
        && (data.video.get('title', '') is string && data.video.get('title', '').size() <= 4096)
        && (data.get('summary', null) == null || (data.get('summary', '') is string && data.get('summary', '').size() <= 250000))
        && (data.get('transcript', null) == null || (data.get('transcript', '') is string && data.get('transcript', '').size() <= 3000000))
        && (data.get('key_points', null) == null || data.get('key_points', []) is list)
        && (data.get('quiz', null) == null || data.get('quiz', []) is list)
        && (data.get('mind_map', null) == null || data.get('mind_map', {}) is map || data.get('mind_map', '') is string || data.get('mind_map', []) is list)
        && (data.get('limitations', null) == null || data.get('limitations', []) is list)
        && (data.get('tutor_questions', null) == null || data.get('tutor_questions', []) is list)
        && (data.get('flashcards', null) == null || data.get('flashcards', []) is list);
    }

    function isValidPreference(data) {
      return data.defaultStudyFormat in ['summary', 'quiz', 'tutor', 'mindmap', 'flashcards']
        && data.explanationLevel in ['basic', 'intermediate', 'advanced']
        && data.defaultQuizQuestionCount in [5, 10, 15, 20, 25];
    }

    // --- Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isVerified() && isValidId(userId) && userId == request.auth.uid 
        && incoming().keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt', 'plan'])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().plan == 'free'
        && isValidUser(incoming());
      
      allow update: if isOwner(userId) 
        && incoming().updatedAt == request.time
        && incoming().uid == userId
        // plan and subscription details only changeable by admin (or remains unchanged)
        && (incoming().get('plan', 'free') == existing().get('plan', 'free'))
        && (incoming().get('subscriptionStatus', 'active') == existing().get('subscriptionStatus', 'active'))
        && (incoming().get('stripeCustomerId', '') == existing().get('stripeCustomerId', ''))
        && (incoming().get('stripeSubscriptionId', '') == existing().get('stripeSubscriptionId', ''))
        && (incoming().get('stripePriceId', '') == existing().get('stripePriceId', ''))
        && isValidUser(incoming());

      // Sub-collection rule for billing details
      match /billing/{billingId} {
        allow read: if isOwner(userId);
      }

      // Sub-collection rule for preferences following Master Gate pattern (check parent)
      match /preferences/{preferenceId} {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(preferenceId)
          && exists(/databases/$(database)/documents/users/$(userId)) // Master Gate
          && incoming().keys().hasAll(['defaultStudyFormat', 'explanationLevel', 'defaultQuizQuestionCount', 'updatedAt'])
          && incoming().updatedAt == request.time
          && isValidPreference(incoming());
        allow update: if isOwner(userId)
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['defaultStudyFormat', 'explanationLevel', 'defaultQuizQuestionCount', 'updatedAt'])
          && isValidPreference(incoming());
      }

      // Sub-collection rule following Master Gate pattern (check parent)
      match /analyses/{analysisId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().userId == userId
          && incoming().createdAt == request.time
          && isValidAnalysis(incoming());
        allow update: if isOwner(userId)
          && incoming().userId == userId
          && isValidAnalysis(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
